# ASRILup BFF — environment. Copy to `.env` and fill DB_PASSWORD locally.
# NEVER commit the real password. (The legacy Web.config leaked it; don't repeat that.)

# --- SQL Server: GeneralAffairDB (all usp_CMS_* + auth SPs) ---
# Host may include a named instance: "10.10.0.42\SQLDEVOPERATION2".
DB_HOST=10.10.0.42\SQLDEVOPERATION2
DB_PORT=1433
DB_NAME=GeneralAffairDB
DB_USER=sa
DB_PASSWORD=

# Secondary DB holding the usp_CMS_AssetGroup* SPs (Group Access + Asset Group
# master) — same server/credentials, different database. Group Access routes
# there; everything else stays on DB_NAME. Default: AssetICTDB.
DB_GROUP_NAME=AssetICTDB

# --- BFF server ---
PORT=8080

# Browser origin allowed by CORS (the Vite dev server).
SPA_ORIGIN=http://localhost:5173

# Local http dev only: drop the Secure flag so the session cookie is stored
# over http://localhost. NEVER set this in a deployed (HTTPS) environment.
SESSION_COOKIE_INSECURE=1
